#!/usr/bin/env bash
# Run from any directory. Timings vary; settings and presentation stay the same.
set -euo pipefail

if [[ ${1:-} == --help ]]; then
    cat <<'HELP'
Usage: scripts/benchmark [--baseline RESULTS_DIRECTORY]
       scripts/benchmark --report RESULTS_DIRECTORY [--baseline RESULTS_DIRECTORY]

Runs 14 subtitle CLI scenarios (3 warmups, 10 measurements) and all 8
glob microbenchmarks sequentially. Linux kernel scenarios are excluded.

Requires Python 3, Rust 1.96.0, nightly Rust, and prepared subtitle corpora.
Overrides: BENCH_CORPUS_DIR (default /tmp/rg-bench)
           BENCH_OUTPUT_DIR (default a new directory under /tmp)

Compare changes:
  BENCH_OUTPUT_DIR=/tmp/rg-before scripts/benchmark
  # Edit code, then run:
  BENCH_OUTPUT_DIR=/tmp/rg-after scripts/benchmark --baseline /tmp/rg-before

Terminal output uses aligned tables, bold headings, and colored FASTER/SLOWER/SAME
labels. Narrow terminals use stacked rows. Saved summary.md stays free of ANSI codes.
Use --report to redisplay existing results without rebuilding or benchmarking.
Set NO_COLOR=1 to disable color, or FORCE_COLOR=1 to enable it when piping output.
Results are screening signals; repeat runs to confirm improvements.

Setup from the repository root:
  rustup toolchain install 1.96.0 nightly
  python3 benchsuite/benchsuite --dir /tmp/rg-bench --download subtitles-en
  python3 benchsuite/benchsuite --dir /tmp/rg-bench --download subtitles-ru
HELP
    exit 0
fi
export BENCH_BASELINE_DIR=''
report_directory=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        --baseline|--report)
            if [[ $# -lt 2 || ! -d "$2" ]]; then
                echo "Expected an existing results directory after $1." >&2
                exit 2
            fi
            directory=$(cd "$2" && pwd)
            for artifact in cli.csv glob.log environment.txt; do
                if [[ ! -r "$directory/$artifact" ]]; then
                    echo "Missing result artifact: $directory/$artifact" >&2
                    exit 1
                fi
            done
            if [[ $1 == --baseline ]]; then
                BENCH_BASELINE_DIR=$directory
            else
                report_directory=$directory
            fi
            shift 2
            ;;
        *)
            echo 'Unknown argument. Use --help for usage.' >&2
            exit 2
            ;;
    esac
done

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n $report_directory ]]; then
    BENCH_OUTPUT_DIR=$report_directory python3 scripts/benchmark-report.py
    exit 0
fi

bold='' cyan='' reset=''
if [[ -z ${NO_COLOR+x} ]] && { [[ ${FORCE_COLOR:-0} != 0 ]] ||
    { [[ -t 1 ]] && [[ ${TERM:-} != dumb ]]; }; }; then
    bold=$'\033[1m' cyan=$'\033[36m' reset=$'\033[0m'
fi
step() {
    printf '\n%s%s[%s/4]%s %s%s%s\n' "$bold" "$cyan" "$1" "$reset" "$bold" "$2" "$reset"
}
printf '\n%sRIPGREP BENCHMARKS%s\n' "$bold" "$reset"
printf 'Suites run sequentially. CLI: 3 warmups + 10 measurements per variant.\n'
if [[ -n $BENCH_BASELINE_DIR ]]; then
    printf 'Comparing against: %s\n' "$BENCH_BASELINE_DIR"
else
    printf 'Baseline mode: timings only; use --baseline to compare changes.\n'
fi
export BENCH_CORPUS_DIR="${BENCH_CORPUS_DIR:-/tmp/rg-bench}"
export BENCH_OUTPUT_DIR="${BENCH_OUTPUT_DIR:-$(mktemp -d /tmp/rg-benchmark.XXXXXX)}"
mkdir -p "$BENCH_OUTPUT_DIR"
# Resolve paths before the CLI runner changes its search working directory.
BENCH_CORPUS_DIR=$(cd "$BENCH_CORPUS_DIR" && pwd)
BENCH_OUTPUT_DIR=$(cd "$BENCH_OUTPUT_DIR" && pwd)
export CARGO_TARGET_DIR="$PWD/target"
export PATH="$CARGO_TARGET_DIR/release:$PATH"
# User ripgrep configuration must not alter the benchmark workload.
unset RIPGREP_CONFIG_PATH

trap 'echo "Benchmark run failed. Logs: $BENCH_OUTPUT_DIR" >&2' ERR
for corpus in en.sample.txt ru.txt; do
    if [[ ! -s "$BENCH_CORPUS_DIR/subtitles/$corpus" ]]; then
        echo "Missing subtitle corpus: $corpus. See scripts/benchmark --help." >&2
        exit 1
    fi
done
if [[ -e "$BENCH_OUTPUT_DIR/cli.csv" || -e "$BENCH_OUTPUT_DIR/glob.log" ]]; then
    echo 'Output directory already contains results; choose a new BENCH_OUTPUT_DIR.' >&2
    exit 1
fi

step 1 'BUILD - release CLI and glob benchmarks'
cargo +1.96.0 build --release --locked >"$BENCH_OUTPUT_DIR/cli-build.log" 2>&1
cargo +nightly bench --locked -p globset --bench bench --no-run \
    >"$BENCH_OUTPUT_DIR/glob-build.log" 2>&1
{
    rustc +1.96.0 --version
    rustc +nightly --version
    rg --version
    uname -sm
    git rev-parse HEAD
    git status --short
} >"$BENCH_OUTPUT_DIR/environment.txt"

step 2 'VALIDATE - checking all 27 CLI variants'
python3 - <<'PY' >"$BENCH_OUTPUT_DIR/validation.log" 2>&1
import os
import runpy
import subprocess

suite = runpy.run_path("benchsuite/benchsuite")
benches = suite["collect_benchmarks"](
    os.environ["BENCH_CORPUS_DIR"], filter_pat="^subtitles_",
    allow_missing_commands=True,
    disabled_cmds=["ag", "git", "ugrep", "grep", "sift"],
)
assert len(benches) == 14, f"Expected 14 scenarios, found {len(benches)}"
count = 0
for bench in benches:
    for command in bench.commands:
        if command.binary_name != "rg":
            continue
        result = subprocess.run(command.cmd, stdout=subprocess.DEVNULL,
                                stderr=subprocess.PIPE, **command.kwargs)
        assert result.returncode in (0, 1) and not result.stderr, (
            bench.name, command.name, result.returncode, result.stderr)
        print(bench.name, command.name, result.returncode, flush=True)
        count += 1
assert count == 27, f"Expected 27 variants, found {count}"
PY

step 3 'MEASURE CLI - 270 samples; this takes several minutes'
python3 benchsuite/benchsuite \
    --dir "$BENCH_CORPUS_DIR" --allow-missing \
    --disabled ag,git,ugrep,grep,sift --warmup-iter 3 --bench-iter 10 \
    --raw "$BENCH_OUTPUT_DIR/cli.csv" '^subtitles_' \
    >"$BENCH_OUTPUT_DIR/cli.log" 2>&1

step 4 'MEASURE GLOB - 8 microbenchmarks'
cargo +nightly bench --locked -p globset --bench bench \
    >"$BENCH_OUTPUT_DIR/glob.log" 2>&1

python3 scripts/benchmark-report.py
